# Where the Vite dev server proxies /api and /sanctum.
#
# Only needed if the Laravel app is not on the default port. The proxy keeps the
# session cookie first-party in development, which is what lets Sanctum work
# without any CORS configuration.
#
# Not required for a production build: there the SPA and the API are served from
# the same origin, so the paths resolve without a proxy.
VITE_BACKEND_URL=http://localhost:8000
